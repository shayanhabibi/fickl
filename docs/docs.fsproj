<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
        <!-- The site is not part of the compiler's solution or its warnings-as-errors settings. -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Spec.fs" />
        <Compile Include="Theme.fs" />
        <Compile Include="Directives.fs" />
        <Compile Include="FicklExamples.fs" />
        <Compile Include="Readme.fs" />
        <Compile Include="Site.fs" />
        <Content Include="content\**" CopyToOutputDirectory="Never" />
        <Content Include="static\**" CopyToOutputDirectory="Never" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Nacara.Core" Version="2.0.0-beta.6" />
        <PackageReference Include="Nacara.Plugin.Markdown" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Highlight.TreeSitter" Version="1.0.0-beta.3" />
        <PackageReference Include="Nacara.Plugin.Sitemap" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.LinkValidator" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Versions" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.Assets.LightningCss" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.Assets.Esbuild" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.Assets.Nuglify" Version="1.0.0-beta.1" />
        <PackageReference Include="FSharp.Core" Version="11.0.101-rc1.26425.128" />
        <PackageReference Include="Partas.Nacara.Theme" Version="0.3.0" />
        <PackageReference Include="Partas.Nacara.Plugins.Directives" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.AgentFriendly" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.OgImage" Version="0.1.0" />
    </ItemGroup>
</Project>
