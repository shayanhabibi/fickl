export type Gender_$union = 
    | Gender<0>
    | Gender<1>

export type Gender_$cases = {
    0: ["Male", []],
    1: ["Female", []]
}

export function Gender_Male() {
    return Gender.Male;
}

export function Gender_Female() {
    return Gender.Female;
}

export class Gender<Tag extends keyof Gender_$cases> extends Union<Tag, Gender_$cases[Tag][0]> {
    constructor(tag: Tag, fields: Gender_$cases[Tag][1]) {
        super();
        this.tag = tag;
