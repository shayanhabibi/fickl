export function describe(): string {
    const matchValue: IOType_$union = IOType.Sample;
    switch (matchValue.tag) {
        case /* Sample */ 1:
            return "sample";
        case /* FreeText */ 2:
            return matchValue.fields[0] as string;
        default:
            return "source";
    }
}

