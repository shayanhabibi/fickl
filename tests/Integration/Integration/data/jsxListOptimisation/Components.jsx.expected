export function divWithConditionalChildren(a) {
    return <div>
        {(a === "b") ? (<div>
            true
        </div>) : (<div>
            false
        </div>)}
    </div>;
}

export const divWithForLoop = <div>
    <div>
        Hello
    </div>
    {map((i) => <div key={int32ToString(i)}>
        {i}
    </div>, rangeDouble(0, 1, 2))}
</div>;

