    </div>
</div>;

export function divWithConditionalWithoutElseBranchWorks(show) {
    return <div>
        {show ? (<div>
            I show sometimes!
        </div>) : (null)}
        <div>
            I show always!
        </div>
    </div>;
}

export const propsCanUseUnbox = <div id="myid" />;

export function divWithMatchContainingForLoop(counter) {
    return <div>
        {(() => {
            if (counter === 0) {
                return singleton(<div>
                    No items!
                </div>);
            }
            else {
                const total = (counter + 1) | 0;
                return map((i) => <div key={int32ToString(i)}>
                    {i + total}
                </div>, rangeDouble(1, 1, total));
            }
        })()}
    </div>;
}

export function divWithElementBeforeMatchContainingForLoop(counter) {
    return <div>
        <div>
            Header
        </div>
        {(() => {
            const matchValue = counter | 0;
            if (matchValue === 0) {
                return singleton(<div>
                    No items!
                </div>);
            }
            else {
                const total = (matchValue + 1) | 0;
                return map((i) => <div key={int32ToString(i)}>
                    {i + total}
                </div>, rangeDouble(1, 1, total));
            }
        })()}
    </div>;
}

export const divWithLongClassName = <div className="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" />;

export const spreadProps = {
    "data-testid": "spread-target",
    title: "from-spread",
};

export const divWithSpread = <div {...spreadProps} />;

export const divWithSpreadBetweenProps = <div className="before"
    {...spreadProps}
    title="after" />;

export const divWithSpreadOverridingProps = <div title="before"
    {...spreadProps} />;

export const divWithTwoSpreads = <div {...spreadProps}
    {...{
        title: "second",
    }} />;

export const divWithSpreadAndChildren = <div {...spreadProps}>
    <div>
        Child
    </div>
</div>;

export function divWithConditionalProp(isActive) {
    return <div data-testid="target"
        {...isActive ? {
            className: "active",
        } : {}}
        title="always" />;
}

export function divWithConditionalPropAfterProp(isActive) {
    return <div data-testid="target"
        title="always"
        {...isActive ? {
            title: "active",
        } : {}} />;
}

export function divWithConditionalPropWithElseBranch(isActive) {
    return <div data-testid="target"
        {...isActive ? {
            className: "active",
        } : {
            title: "inactive",
        }} />;
}

export function divWithSeveralConditionalProps(isActive) {
    return <div data-testid="target"
        {...isActive ? {
            className: "active",
            title: "active",
        } : {}}>
        <div>
            Child
        </div>
    </div>;
}

export function divWithNestedConditionalProps(isActive, isFirst) {
    return <div data-testid="target"
        {...isActive ? Object.assign({}, {
            className: "active",
        }, spreadProps, isFirst ? {
            title: "first",
        } : {}) : {}} />;
}

export function divWithConditionalSpread(isActive) {
    return <div data-testid="target"
        title="before"
        {...isActive ? spreadProps : {}} />;
}

export const divWithYieldBangProps = <div data-testid="target"
    className="header"
    title="yielded"
    id="myid" />;

