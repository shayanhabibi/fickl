
import { filter } from "./fable_modules/fable-library-ts.5.27.0/Seq.ts";
import { type FSharpList, singleton } from "./fable_modules/fable-library-ts.5.27.0/List.ts";

export type Level = 
    | "low"
    | "high"

export function describe(level: Level): string {
    if (level === "high") {
        return "high";
    }
    else {
        return "low";
    }
}

export function levelNames(levels: Iterable<Level>): Iterable<Level> {
    return filter<Level>((level: Level): boolean => (level === "high"), levels);
}

export function pair(level: Level): [Level, FSharpList<Level>] {
    return [level, singleton(level)] as [Level, FSharpList<Level>];
}

