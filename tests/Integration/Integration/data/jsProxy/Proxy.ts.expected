        super();
        this.X = (X | 0);
        this.Y = (Y | 0);
    }
}

export function Point_$reflection(): TypeInfo {
    return record_type("Proxy.Point", [], Point, () => [["X", int32_type], ["Y", int32_type]]);
}

export const reads: string[] = [];

export function logged(point: Point): Point {
