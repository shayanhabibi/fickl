            }
            return Reflect.get(target, key, receiver);
        },
    } satisfies Partial<ProxyHandler<Point>> as ProxyHandler<Point>));
}

export function readOnly(point: Point): { proxy: Point; revoke: () => void } {
    return Proxy.revocable(point, ({
        set: (_arg: Point, _arg_1: string | float64 | (symbol), _arg_2: any, _arg_3: any): boolean => false,
    } satisfies Partial<ProxyHandler<Point>> as ProxyHandler<Point>));
}

export function keys(o: any): MutableArray<string | float64 | (symbol)> {
    return Reflect.ownKeys(o);
}

export const tag: symbol = Symbol("tag");

export const tagKey: symbol = tag;

