<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The compiled assembly, not its project, so its attributes come from metadata -->
    <Reference Include="Support">
      <HintPath>../Support/bin/Release/netstandard2.0/Support.dll</HintPath>
    </Reference>
    <ProjectReference Include="../../../../../src/Fable.Core/Fable.Core.fsproj" />
    <ProjectReference Include="../../../../../src/Fickl.Core/Fickl.Core.fsproj" />
  </ItemGroup>
</Project>
