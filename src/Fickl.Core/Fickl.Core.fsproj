<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>false</DisableImplicitFSharpCoreReference>
    <Description>Fickl Core Library: Fickl-only attributes and Fickl.Core aliases over Fable.Core</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fickl.Core.Types.fs" />
    <Compile Include="Fickl.Core.TypeScript.fs" />
    <Compile Include="Fickl.Core.Keys.fs" />
    <Compile Include="Fickl.Core.Decorators.fs" />
    <Compile Include="Fickl.Core.JsInterop.fs" />
    <Compile Include="Fickl.Core.JS.fs" />
    <Compile Include="Fickl.Core.Events.fs" />
    <Compile Include="Fickl.Core.Cancellation.fs" />
    <Compile Include="Fickl.Core.NativeAsync.fs" />
    <Compile Include="Fickl.Core.NativeGenerators.fs" />
    <Compile Include="Fickl.Core.NativeAsyncGenerators.fs" />
    <Compile Include="Fickl.Core.TypedArrays.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fable.Core/Fable.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="4.7.2" />
  </ItemGroup>
</Project>
